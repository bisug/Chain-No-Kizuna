# Environment & System
.env
.venv/
venv/
ENV/
**/.DS_Store
*.log
*.tmp
Thumbs.db

# Caches & Build
**/__pycache__/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.build/
dist/
build/
*.pyc
*.pyo
*.pyd

# Project Specific
# wordlist.txt is deliberately tracked: it is the pinned word list the bot
# validates against, replacing the old runtime download of a remote source.
# Other data/*.txt files are runtime caches and stay ignored.
chainnokizuna/data/*.txt
!chainnokizuna/data/wordlist.txt
!chainnokizuna/data/.gitkeep
config*.json

# NOTE: uv.lock and .python-version are intentionally tracked. The Dockerfile
# builds with `uv sync --frozen`, which requires a committed lockfile.
