# ==========================================
# Chain no Kizuna - Environment Template
# ==========================================
# Copy this file to .env and fill in the values.
#
# Variables marked [REQUIRED] have no built-in default: the bot refuses to
# start until they are set. Never commit real credentials.

# --- Bot Tokens & Identity ---
# Main Telegram Bot Token (Get from @BotFather)   [REQUIRED]
TOKEN=
# Virtual Player Bot Token (Optional, get from @BotFather)
VP_TOKEN=

# --- Database & Cache ---
# MongoDB connection URI (Get from MongoDB Atlas or local DB)   [REQUIRED]
MONGO_URI=
# Redis/Valkey connection URL (Get from Upstash or redis.io)    [REQUIRED]
REDIS_URL=
# Name of the MongoDB database
DB_NAME=WordChainDB

# ◈ Support & Community
SUPPORT_GROUP=SuMelodyVibes
UPDATE_CHANNEL=SuMelodyVibes

# --- Administrative Configuration ---
# Your numeric Telegram user ID (Get from @userinfobot)   [REQUIRED]
OWNER_ID=
# ID of the group where admin logs will be sent (0 disables)
ADMIN_GROUP_ID=0
# ID of the official game group (0 disables)
OFFICIAL_GROUP_ID=0
# ID of the channel where word additions are announced (0 disables)
WORD_ADDITION_CHANNEL_ID=0

# --- Permissions & Access ---
# Comma-separated list of VIP user IDs or JSON list
VIP=[]
# Comma-separated list of VIP group IDs or JSON list
VIP_GROUP=[]

# --- Logging ---
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

